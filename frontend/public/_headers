/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://upsetalert-api.upsetalert.ca; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self' https://static.cloudflareinsights.com; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;

# Asset filenames are content-hashed, so a given URL's bytes never change —
# cache them permanently. Nothing here is the stale-index problem: that is
# index.html pointing at a hash, and index.html is covered below.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html maps names to the current hashes, so a cached copy is how a browser
# ends up asking for a bundle that no longer exists. Always revalidate.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
# The service worker decides when the app updates; a cached one pins it.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
