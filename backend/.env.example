DATABASE_URL=sqlite+aiosqlite:///./tennis_fantasy.db

# Signs every session token, and the subject is just str(user.id) — so anyone
# who knows this value can mint a valid session for any account. Generate your
# own and never commit it:
#   python -c 'import secrets; print(secrets.token_urlsafe(64))'
# With ENVIRONMENT=production the app refuses to start if this is left as the
# placeholder below.
SECRET_KEY=change-me-to-a-long-random-string

ACCESS_TOKEN_EXPIRE_MINUTES=10080

# development | production. Production enables the SECRET_KEY guard above and
# is required by the scrapers.
ENVIRONMENT=development

# Transactional email (Resend). Empty -> email is skipped, not an error.
RESEND_API_KEY=

# Web Push (VAPID). Empty -> push is skipped, not an error.
# Generate a pair with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
