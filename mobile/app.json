{
  "expo": {
    "name": "Upset Alert",
    "slug": "upset-alert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ca.upsetalert.app",
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "appleTeamId": "8MGTLRPKYF"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "ca.upsetalert.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "expo-notifications",
      "expo-dev-client",
      "@bacons/apple-targets",
      "expo-font"
    ],
    "scheme": "upsetalert",
    "owner": "dogger27",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1c3b317b-d9fc-420d-a710-7ca680db7ce8"
      }
    }
  }
}
